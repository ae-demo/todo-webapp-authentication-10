{
  "name": "todo-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "todo-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7
  ],
  "description": "The single-page app a signed-in user uses to manage their personal todo list: viewing, adding, editing, completing and deleting todos. Signs users in via Thunder SSO and calls todo-api for all data; holds no data of its own.",
  "dependencies": [
    {
      "kind": "component",
      "name": "todo-api",
      "wiring": {
        "endpoint": {
          "component": "todo-webapp-authentication-10-todo-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "TODO_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "todo-webapp-authe-8e6cfca7",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
